program "ensembl-webteam/core" "coverage" 1;
refer "libperegrine";
refer "libeoe";
include "../common/track-common.eard";
include "../common/track-style.eard";

let track_id = setting_string("track_id", []);
let track_name = setting_string("track_name", []);
setup_track(track_id, setting_string("display_order", []));

// Set track height and padding
set_track_style(track_id, "", ["min-height", "padding-top", "padding-bottom"], ["40", "8", "40"]);
set_track_style(track_id, "title/", ["min-height", "padding-top", "padding-bottom"], ["20", "0", "0"]);
set_track_style(track_id, "main/", ["min-height"], ["30"]);
set_track_style(track_id, "main/main/", ["depth"], ["1"]);
// Keep axis/labels on top of graph and anchored to track window
set_track_style(track_id, "main/axis-labels/", ["system", "depth", "bump-height"], ["content", "58", "none"]);
set_track_style(track_id, "main/axis/", ["system", "depth", "bump-height"], ["content", "2", "none"]);

let req = request("self()", "coverage");
scope(req, "datafile", setting_string("datafile", []));
let data = get_data(req);
halt(only_warm());

// Draw coverage graph
let values = data_number(data, "values");
let range = data_number(data, "range");
let start = index(range, 0);
let step = (index(range, 1) - start) / max(len(values), 1);
let starts = enumerate([len(values)]) * step + start;
let high = data_number(data, "high");
let bar_colours = if(high > 0, [colour!("#f08a1c"),...], [colour!("#ffedc2"),...]);
let bars = paint_solid(bar_colours);
rectangle(coord(starts, [0,...], [0,...]), coord(starts + step, values * 30 / 1000, [0,...]), bars, [track_leaf(track_id, "main/main/content"),...]);

// Draw axis and labels
let axis = track_leaf(track_id, "main/axis/content");
let grid = paint_dotted([colour!("transparent"),...], [colour!("#d6dde3"),...], 4, 1, 0.5);
rectangle(coord([0,...], [10,20,30], [0,...]), coord([1,...], [10,20,30], [0,...]), grid, [axis,...]);
let baseline = paint_solid(colour!("#fbb44b"));
rectangle(coord([0], [0], [0]), coord([1], [1], [0]), baseline, [axis,...]);
let axis_pen = pen("'IBM Plex Mono', sans-serif", -10, [colour!("#9aa7b1"),...], [colour!("transparent"),...]);
text(coord([1,...], [7,17,27], [-48,...]), axis_pen, [">100", ">1,000", ">10,000"], [track_leaf(track_id, "main/axis-labels/content"),...]);

// Draw track furniture
empty(coord([0], [0], [0]), coord([1], [30], [0]), [track_leaf(track_id, "main/main/content"),...]);
let name_leaf = if(setting_boolean("name", []), track_leaf(track_id, "title/content"), leaf(""));
let name_pen = pen("'IBM Plex Mono', sans-serif", 12, [colour!("#9aa7b1"),...], [colour!("transparent"),...]);
text(coord([0], [0], [8]), name_pen, [track_name], [name_leaf,...]);
empty(coord([0], [0], [0]), coord([1], [20], [0]), [track_leaf(track_id, "title/content"),...]);
draw_track_category(["G"], [track_id], [track_leaf(track_id, "main/letter/content")]);
