export procedure make_dynamic_gene_leaf_base(track_id,*gene) {
    let names = repeat(track_id,len(gene.id_versioned));
    let names = push_str("tracks/track/",names);
    let names = push_str(names,"/main/main/");
    push_str(names,gene.id_versioned)
}

export procedure make_focus_gene_leaf_base(*gene) {
    push_str("tracks/track/focus-gene/main/main/",gene.id_versioned)
}

export procedure make_focus_gene_leaf(suffix,enabled) {
    leaf(if(enabled,join("/",["tracks/track/focus-gene",suffix]),""))
}

export procedure make_focus_transcript_leaf(suffix,enabled) {
    leaf(if(enabled,join("/",["tracks/track/focus-transcript",suffix]),""))
}

export function gene_colour() {
    colour!("#0099ff")
}

let num_chevrons = 40;
let chevron_spacing = enumerate([num_chevrons]) / num_chevrons;

export procedure draw_dynamic_track_chevrons(track_id,strand) {
    capture chevron_spacing;

    let image = if(strand>0,["chevron-right",...],["chevron-left",...]);
    let leaf = track_leaf(track_id,"main/background/content");
    image(coord(chevron_spacing,[0,...],[0,...]),image,[leaf,...]);
}

export procedure draw_dynamic_sidebar_chevrons(track_id,strand) {
    let image = if(strand>0,["chevron-dark-right",...],["chevron-dark-left",...]);
    let leaf = if(setting_boolean("no-padding",[]),leaf(""),track_leaf(track_id,"main/letter/content"));
    image(coord([0],[0],[24]),image,[leaf,...]);
}

export procedure draw_focus_track_chevrons(strand,*leaf) {
    capture chevron_spacing;

    let image = if(index(strand,0)>0,["chevron-right",...],["chevron-left",...]);
    image(coord(chevron_spacing,[0,...],[0,...]),image,[if(len(strand)>0,leaf.bgd,leaf("")),...]);
}

export procedure draw_focus_sidebar_chevrons(strand,*leaf) {
    let image = if(index(strand,0)>0,["chevron-dark-right",...],["chevron-dark-left",...]);
    image(coord([0],[0],[24]),image,[if(len(strand)>0,leaf.bgd,leaf("")),...]);
}
